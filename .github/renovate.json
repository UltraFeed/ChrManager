{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends":
	[
		"config:best-practices",
		":disableDependencyDashboard",
		":disableRateLimiting",
		":automergeDigest",
		":automergeMinor"
	],
	"git-submodules":
	{
		"enabled": true
	},
	"automergeType": "pr",
	"automergeStrategy": "squash",
	"platformAutomerge": true,
	"recreateWhen": "always"
}
