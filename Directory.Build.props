<Project>

	<!-- Assembly metadata -->
	<PropertyGroup>
		<Version>1.0.1</Version>
	</PropertyGroup>

	<!-- Paths and output directories -->
	<PropertyGroup>
		<RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
		<TemporaryRoot>$(RepositoryRoot)tmp/</TemporaryRoot>
		<BinRoot>$(TemporaryRoot)bin/</BinRoot>
		<ObjRoot>$(TemporaryRoot)obj/</ObjRoot>

		<BaseIntermediateOutputPath>$(ObjRoot)$(MSBuildProjectName)/</BaseIntermediateOutputPath>
		<BaseOutputPath>$(ObjRoot)build/$(MSBuildProjectName)/</BaseOutputPath>
		<DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**;$(TemporaryRoot)**</DefaultItemExcludes>
		<PublishDir Condition="'$(Configuration)' != 'Release'">$(BinRoot)publish/$(MSBuildProjectName)/$(Configuration)/$(RuntimeIdentifier)/</PublishDir>
		<PublishDir Condition="'$(Configuration)' == 'Release'">$(BinRoot)release/</PublishDir>
	</PropertyGroup>

	<!-- Target framework and platforms -->
	<PropertyGroup>
		<WindowsVersion>10.0.17763.0</WindowsVersion>
		<TargetFramework>net11.0-windows$(WindowsVersion)</TargetFramework>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<PlatformTarget>x64</PlatformTarget>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<RollForward>LatestMajor</RollForward>
		<TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
	</PropertyGroup>

	<!-- Compiler settings -->
	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Deterministic>true</Deterministic>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<!-- Diagnostics and code analysis -->
	<PropertyGroup>
		<LangVersion>latest</LangVersion>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<WarningLevel>8</WarningLevel>
		<NoWarn>1701;1702</NoWarn>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<WarningsAsErrors>$(WarningsAsErrors);NU1605</WarningsAsErrors>
		<ErrorReport>none</ErrorReport>
	</PropertyGroup>

	<!-- Publishing -->
	<PropertyGroup>
		<!-- Deployment -->
		<SelfContained>false</SelfContained>
		<PublishSelfContained>true</PublishSelfContained>
		<PublishSingleFile>false</PublishSingleFile>

		<!-- Compilation and optimization -->
		<PublishAot>true</PublishAot>
		<OptimizationPreference>size</OptimizationPreference>
		<IlcTreatWarningsAsErrors>true</IlcTreatWarningsAsErrors>
		<ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>

		<!-- Preserve metadata and resources -->
		<PublishTrimmed>true</PublishTrimmed>
	</PropertyGroup>

	<!-- Author information -->
	<PropertyGroup>
		<Authors>UltraFeed</Authors>
		<Company>UltraFeed</Company>
		<Copyright>Copyright © 2015-$([System.DateTime]::UtcNow.Year) $(Company)</Copyright>
		<Description>Portable browser updater for Windows x64.</Description>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/$(Company)/ChrManager</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotes>$(PackageProjectUrl)/releases</PackageReleaseNotes>
		<PublishDocumentationFile>false</PublishDocumentationFile>
		<PublishDocumentationFiles>false</PublishDocumentationFiles>
		<RepositoryBranch>main</RepositoryBranch>
		<RepositoryType>Git</RepositoryType>
		<RepositoryUrl>$(PackageProjectUrl).git</RepositoryUrl>
	</PropertyGroup>

	<!-- Debug configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<Optimize>false</Optimize>
		<IlcDehydrate>false</IlcDehydrate>
		<DebugType>portable</DebugType>
		<StripSymbols>false</StripSymbols>
	</PropertyGroup>

</Project>
